Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:app|storage|docs|tests|tmp|\.git|\.codex|\.agents)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "(?i)^(?:\.env.*|.*\.(?:sqlite|sqlite3|db|log|pdf|md|json|ini|bak|sql|sh))$">
Require all denied
</FilesMatch>
<Files "router.php">
Require all denied
</Files>
